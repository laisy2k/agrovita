
@startuml Fisico
title Modelo Fisico do Banco de Dados - AgroVita

hide methods
hide stereotypes
skinparam linetype ortho

entity "usuarios" as usuarios {
    * id : BIGINT <<PK>>
    --
    nome : VARCHAR(100) NOT NULL
    email : VARCHAR(150) NOT NULL UNIQUE
    senha : VARCHAR(255) NOT NULL
    tipo : VARCHAR(20) NOT NULL DEFAULT 'usuario'
}

entity "animais" as animais {
    * id : BIGINT <<PK>>
    --
    identificacao : VARCHAR(100) NOT NULL
    especie : VARCHAR(80) NOT NULL
    raca : VARCHAR(100) NULL
    data_nascimento : DATE NULL
    usuario_id : BIGINT NOT NULL <<FK>>
}

entity "manejos" as manejos {
    * id : BIGINT <<PK>>
    --
    animal_id : BIGINT NOT NULL <<FK>>
    usuario_id : BIGINT NOT NULL <<FK>>
    tipo_manejo : VARCHAR(100) NOT NULL
    data_manejo : DATE NOT NULL
    produto : VARCHAR(150) NULL
    dose : VARCHAR(100) NULL
    responsavel : VARCHAR(150) NOT NULL
    observacoes : TEXT NULL
}

entity "vacinacoes" as vacinacoes {
    * id : BIGINT <<PK>>
    --
    animal_id : BIGINT NOT NULL <<FK>>
    usuario_id : BIGINT NOT NULL <<FK>>
    vacina : VARCHAR(150) NOT NULL
    lote : VARCHAR(100) NULL
    fabricante : VARCHAR(150) NULL
    data_aplicacao : DATE NOT NULL
    proxima_dose : DATE NULL
    dose : VARCHAR(100) NULL
    responsavel : VARCHAR(150) NULL
    observacoes : TEXT NULL
}

entity "logs_auditoria" as logs {
    * id : BIGINT <<PK>>
    --
    usuario_id : BIGINT NULL <<FK>>
    acao : VARCHAR(100) NOT NULL
    detalhes : TEXT NULL
    data_hora : DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP
}

usuarios ||--o{ animais : cadastra (DELETE NO ACTION)
usuarios ||--o{ manejos : registra (DELETE NO ACTION)
usuarios ||--o{ vacinacoes : registra (DELETE NO ACTION)
usuarios |o--o{ logs : realiza (DELETE SET NULL)
animais ||--o{ manejos : possui (DELETE NO ACTION)
animais ||--o{ vacinacoes : recebe (DELETE NO ACTION)

@enduml
