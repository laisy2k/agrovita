@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Diagrama de Contexto - AgroVita

Person(usuario, "Usuário", "Responsável pelo controle sanitário dos animais.")

System(agrovita, "AgroVita", "Sistema web para controle de animais, vacinações e manejos sanitários.")

Rel(usuario, agrovita, "Utiliza para registrar e acompanhar animais, vacinações e manejos")

@enduml